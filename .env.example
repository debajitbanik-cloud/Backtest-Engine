# Trading System Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# POSTGRESQL
# =============================================================================
POSTGRES_DB=trading
POSTGRES_USER=trader
POSTGRES_PASSWORD=changeme

# =============================================================================
# REDIS
# =============================================================================
# REDIS_PASSWORD=changeme
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://trader:changeme@localhost:5432/trading

# =============================================================================
# MINIO (S3-compatible object storage)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
# Derived MinIO object-storage settings (consumed via docker-compose)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=trading-data

# =============================================================================
# BRIDGE (Python bridge auth + UI proxy backend)
# =============================================================================
# Bearer token required by all auth-enforced bridge endpoints.
BRIDGE_AUTH_TOKEN=change-me-to-a-long-random-token
# UI server -> bridge URL (use http://trading-app:8088 inside compose).
BRIDGE_URL=http://127.0.0.1:8088
# Bind hosts (default loopback; set to 0.0.0.0 when containerised).
BRIDGE_HOST=127.0.0.1
HOST=127.0.0.1
UI_HOST=127.0.0.1

# =============================================================================
# DELTA EXCHANGE
# =============================================================================
# Get from https://testnet.delta.exchange or https://delta.exchange
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_ENVIRONMENT=testnet  # testnet or production

# =============================================================================
# MODEL PROVIDERS
# =============================================================================
# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=

# LiteLLM (universal proxy for 100+ models)
# LITELLM_API_KEY=
# LITELLM_BASE_URL=http://localhost:4000

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# Google Vertex AI (for ADK)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# =============================================================================
# MT5 (MetaTrader 5) - Windows host only
# =============================================================================
MT5_HOST=host.docker.internal
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# =============================================================================
# DATA FEED MODE
# =============================================================================
# file, live, or delta
DATA_FEED=file

# =============================================================================
# MODEL PROVIDER SELECTION
# =============================================================================
# deepseek, openai, litellm, anthropic
MODEL_PROVIDER=deepseek

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# APP SECRETS / MISC
# =============================================================================
SECRET_KEY=dev-secret-change-in-production
CLIENT_IP=127.0.0.1
XAU_AI_REPO_PATH=
PERPLEXITY_API_KEY=

# =============================================================================
# GRAFANA
# =============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# =============================================================================
# DOMAIN (for Caddy TLS)
# =============================================================================
# DOMAIN=trading.yourdomain.com
# EMAIL=your-email@example.com