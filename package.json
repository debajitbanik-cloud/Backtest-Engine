{
  "name": "backtest-engine",
  "version": "1.0.0",
  "description": "Multi-Agent Trading System with Leverage Adjustment, Bias Detection, Multi-TimeFrame Confluence, Position Sizing, Style Management, Risk Checking, and Trade Master",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:real": "ts-node src/index.ts --real-data --symbol BTCUSDT --timeframe 15m",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "trading",
    "backtest",
    "multi-agent",
    "algorithmic-trading",
    "risk-management",
    "position-sizing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.2.33"
  }
}
